<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
{%- set pageTitle = (title + " · " + site.name) if (title and title != site.name) else (site.name + " · " + site.title) %}
<title>{{ pageTitle | striptags }}</title>
<meta name="claude:viewport-fit-sides" content="cover">
<meta name="description" content="{{ (description or site.description) | striptags }}">
<meta property="og:title" content="{{ pageTitle | striptags }}">
<meta property="og:description" content="{{ (description or site.description) | striptags }}">
<meta property="og:type" content="website">
<meta property="og:image" content="assets/img/headshot-800.jpg">
<link rel="icon" href="assets/img/headshot-400.jpg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..100,500..800&family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&display=swap">
<link rel="stylesheet" href="assets/css/style.css">
</head>
<body>
<a class="skip" href="#main">Skip to content</a>

<header class="site-header">
  <div class="wrap header-inner">
    <a class="wordmark" href="index.html">
      <span class="wordmark-name">{{ site.name }}</span>
      <span class="wordmark-role">{{ site.title }} · {{ site.affiliation }}</span>
    </a>
    <nav class="site-nav" aria-label="Main">
      <ul>
        {%- for item in navigation %}
        <li><a href="{{ item.url }}"{% if item.url | isCurrent(page.url) or (section and item.url == section) %} aria-current="page"{% endif %}>{{ item.title }}</a></li>
        {%- endfor %}
      </ul>
    </nav>
  </div>
</header>

<main id="main">
{{ content | safe }}
</main>

<footer class="site-footer">
  <div class="wrap footer-inner">
    <div class="footer-contact">
      <p class="footer-name">{{ site.name }}</p>
      <p>{{ site.title }}, {{ site.affiliation }} · {{ site.location }}</p>
      <p>
        <a href="mailto:{{ site.email }}">{{ site.email }}</a>
        {%- if site.phone %} · <a href="tel:{{ site.phone | replace('-', '') }}">{{ site.phone }}</a>{% endif %}
      </p>
    </div>
    <ul class="footer-links">
      {%- for l in site.links %}
      <li><a href="{{ l.url }}" rel="noopener" target="_blank">{{ l.label }}</a></li>
      {%- endfor %}
      <li><a href="{{ site.cv_file }}">CV (PDF)</a></li>
    </ul>
  </div>
  <div class="wrap footer-note">
    <p>Paper summaries on this site are my own. Figures from published articles are credited to their publishers.</p>
  </div>
</footer>
</body>
</html>
